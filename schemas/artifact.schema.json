{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/LloydCoder/fas/blob/main/schemas/artifact.schema.json",
  "title":"FAS Artifact","x-fas-canonical-model":"Artifact","x-fas-schema-version":"1.0",
  "type":"object","additionalProperties":false,
  "required":["schema_version","id","analysis_id","type","name","snapshot_id","provenance"],
  "properties":{
    "schema_version":{"type":"string"},"id":{"type":"string","pattern":"^artifact_[0-9A-HJKMNP-TV-Z]{26}$"},
    "analysis_id":{"type":"string","pattern":"^analysis_[0-9A-HJKMNP-TV-Z]{26}$"},
    "type":{"type":"string"},"name":{"type":"string","minLength":1},"media_type":{"type":["string","null"]},
    "size_bytes":{"type":["integer","null"],"minimum":0},"content_hash":{"type":["object","null"]},
    "snapshot_id":{"type":"string","pattern":"^snapshot_[0-9A-HJKMNP-TV-Z]{26}$"},"provenance":{"type":"array","minItems":1},
    "external_reference":{"type":["string","null"]},"metadata":{"type":"object","additionalProperties":{"type":"string"}}
  }
}
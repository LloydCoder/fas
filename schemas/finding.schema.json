{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LloydCoder/fas/blob/main/schemas/finding.schema.json",
  "title": "FAS Finding",
  "x-fas-canonical-model": "Finding",
  "x-fas-schema-version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","id","title","category","snapshot_id","created_at","updated_at"],
  "properties": {
    "schema_version":{"type":"string"},
    "id":{"type":"string","pattern":"^finding_[0-9A-HJKMNP-TV-Z]{26}$"},
    "title":{"type":"string","minLength":1},
    "description":{"type":"string"},
    "category":{"type":"string","minLength":1},
    "severity":{"type":"string","enum":["UNKNOWN","LOW","MEDIUM","HIGH","CRITICAL"]},
    "status":{"type":"string","enum":["CANDIDATE","INVESTIGATING","VERIFIED","CLOSED"]},
    "affected_locations":{"type":"array"},
    "supporting_evidence_ids":{"type":"array","items":{"type":"string"}},
    "contradicting_evidence_ids":{"type":"array","items":{"type":"string"}},
    "related_observation_ids":{"type":"array","items":{"type":"string"}},
    "involved_node_ids":{"type":"array","items":{"type":"string"}},
    "attack_path_ids":{"type":"array","items":{"type":"string"}},
    "snapshot_id":{"type":"string","pattern":"^snapshot_[0-9A-HJKMNP-TV-Z]{26}$"},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "metadata":{"type":"object","additionalProperties":{"type":"string"}}
  }
}

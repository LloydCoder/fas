{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/LloydCoder/fas/schemas/project.schema.json",
  "title":"FAS Project Contract",
  "$defs":{
    "Project":{
      "type":"object",
      "required":["id","name","repository","owner"],
      "properties":{
        "schema_version":{"type":"string"},"id":{"type":"string"},
        "name":{"type":"string"},
        "repository":{"type":"string"},
        "owner":{"type":"string"},
        "created_at":{"type":"string","format":"date-time"}
      }
    }
  }
}
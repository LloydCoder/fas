{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LloydCoder/fas/blob/main/schemas/verification.schema.json",
  "title": "FAS Verification",
  "$ref": "#/$defs/Verification",
  "$defs": {
    "Verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {},
        "id": {},
        "remediation_id": {},
        "finding_id": {},
        "original_snapshot_id": {},
        "candidate_snapshot_id": {},
        "verification_plan_id": {},
        "status": {},
        "checks": {},
        "graph_diff_id": {},
        "attack_path_comparison_ids": {},
        "regressions": {},
        "residual_paths": {},
        "alternate_paths": {},
        "supporting_evidence": {},
        "contradicting_evidence": {},
        "missing_evidence": {},
        "result": {},
        "limitations": {},
        "created_at": {},
        "completed_at": {}
      },
      "required": [
        "id",
        "remediation_id",
        "finding_id",
        "original_snapshot_id",
        "candidate_snapshot_id",
        "verification_plan_id"
      ]
    }
  }
}

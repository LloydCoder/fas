{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LloydCoder/fas/blob/main/schemas/attack-path.schema.json",
  "title": "FAS Attack Path",
  "type": "object",
  "additionalProperties": false,
  "required": ["attack_path_id", "entry", "steps"],
  "properties": {
    "attack_path_id": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "edge", "next"],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "edge": { "type": "string", "minLength": 1 },
          "next": { "type": "string", "minLength": 1 },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "trust_boundaries_crossed": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
